LDAP_BASE_DN=@%@ldap/base@%@
# The container cannot reach the host as localhost. The FQDN resolves to the
# host address, same as the UDM and UMC URLs below.
LDAP_HOST=@%@ldap/server/name@%@
LDAP_HOST_DN=@%@ldap/hostdn@%@
LDAP_PORT=@%@ldap/server/port@%@
LOG_LEVEL=DEBUG
# Unused on UCS, the caches are files. The entrypoint runs with "set -u" and
# reads these without a default, so leaving them out aborts the container.
OBJECT_STORAGE_ACCESS_KEY_ID=stub_user
OBJECT_STORAGE_BUCKET=stub_bucket
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_SECRET_ACCESS_KEY=stub_value
PORTAL_ASSETS_BASE_URL=""
PORTAL_CONSUMER_LOG_STREAM=true
PORTAL_DEFAULT_DN=@%@portal/default-dn@%@
PORTAL_SERVER_ADMIN_GROUP=cn=Domain Admins,cn=groups,@%@ldap/base@%@
PORTAL_SERVER_ASSETS_ROOT_PATH=/usr/share/univention-portal
PORTAL_SERVER_AUTH_MODE=@%@portal/auth-mode@%@
PORTAL_SERVER_DEVELOPMENT_MODE=true
PORTAL_SERVER_EDITABLE=@!@print('true' if configRegistry.get("server/role") == "domaincontroller_master" else 'false', end='')@!@
PORTAL_SERVER_FEATURE_TOGGLES=@!@
import json
prefix = 'portal/feature-toggles/'
print(json.dumps({
    key[len(prefix):]: configRegistry.is_true(key)
    for key in configRegistry if key.startswith(prefix)
}, sort_keys=True), end='')
@!@
PORTAL_SERVER_PORT=80
PORTAL_SERVER_UCS_INTERNAL_PATH=portal-data
PORTAL_SERVER_UMC_CHECK_ICONS=true
PORTAL_SERVER_UMC_GET_URL=http://@%@hostname@%@.@%@domainname@%@/univention/get
PORTAL_SERVER_UMC_SESSION_URL=http://@%@hostname@%@.@%@domainname@%@/univention/get/session-info
PORTAL_UDM_API_PASSWORD_FILE=/etc/machine.secret
PORTAL_UDM_API_URL=http://@%@hostname@%@.@%@domainname@%@/univention/udm/
PORTAL_UDM_API_USERNAME=@%@hostname@%@$
