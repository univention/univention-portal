#! /bin/sh
#
# Univention Portal
#  postinst script for the nubus-portal debian package
#
# SPDX-FileCopyrightText: 2017-2026 Univention GmbH
# SPDX-License-Identifier: AGPL-3.0-only

#DEBHELPER#

# Feature toggles the portal frontend knows about. Listing them all keeps them
# discoverable with "ucr search portal/feature-toggles".
ucr set \
	portal/feature-toggles/api_me?true \
	portal/feature-toggles/centered_layout?false \
	portal/feature-toggles/left_sidebar?false \
	portal/feature-toggles/native_html_list?false \
	portal/feature-toggles/newsfeed?false \
	portal/feature-toggles/notifications_api?false \
	portal/feature-toggles/umc_session_refresh?false \
	portal/feature-toggles/welcome_message?false

# The portal is proxied to the containers. A document root under /var/www
# shadows the apache proxy rules, so drop the links this package used to create.
for portal_path in $(ucr get portal/paths | tr ',' ' '); do
	link="/var/www/${portal_path#/}"
	if [ -L "$link" ] && [ "$(readlink -f "$link")" = "/usr/share/univention-portal" ]; then
		rm -f "$link"
	fi
done

a2ensite univention-portal.conf

# shellcheck source=/dev/null
. /usr/share/univention-lib/all.sh
create_logfile /var/log/univention/portal.log "root:adm" 640

eval "$(ucr shell)"

if [ "$1" = "configure" ]; then
	chmod 700 /var/cache/univention-portal
	if [ ! -f /usr/share/univention-portal/portals.json ]; then
		cp /usr/share/univention-portal/defaults/portals.json /usr/share/univention-portal/portals.json
	fi
	systemctl daemon-reload
	systemctl reload apache2
	systemctl enable --now univention-portal-server.service
	systemctl restart univention-directory-listener
fi

# we do not ship a custom.css, nor do we alter it
# admins may do whatever they want with it and we
# try to keep the DOM stable. but this is only best effort
touch /usr/share/univention-portal/css/custom.css

systemctl restart univention-portal-server

# UMC binds a session to the IP it was issued to. The portal server validates
# sessions from inside the container, so the container network has to be
# allowed to present a session that belongs to the browser. UMC reads this
# variable once at startup, so it has to be restarted when the value changes.
# Without the restart every portal session is destroyed on first use and the
# browser is sent back to the login screen.
portal_subnet="$(docker network inspect univention-portal \
	--format '{{range $i, $c := .IPAM.Config}}{{if $i}},{{end}}{{$c.Subnet}}{{end}}' 2>/dev/null || true)"
if [ -n "$portal_subnet" ]; then
	overtake_ranges="$(ucr get umc/http/allowed-session-overtake/ranges || true)"
	case ",$overtake_ranges," in
		*",$portal_subnet,"*) ;;
		*)
			ucr set umc/http/allowed-session-overtake/ranges="${overtake_ranges:+$overtake_ranges,}$portal_subnet"
			systemctl try-restart univention-management-console-server.service
			;;
	esac
fi

# dpkg runs this script with -e, so these calls are fatal. Give the container
# time to come up rather than failing the moment it is not ready yet.
export UNIVENTION_PORTAL_WAIT=60
univention-portal add-default
univention-portal add-umc-default
univention-portal update

#configuration for portal when apache2/force_https is setting true
ucr set apache2/force_https/exclude/request_uri/univention-portal?/univention/get

if [ "$1" = "configure" ] && dpkg --compare-versions "$2" lt-nl "4.0.5-74"; then
	# shellcheck disable=SC2154
	univention-directory-manager portals/entry modify --dn "cn=univentionforum,cn=entry,cn=portals,cn=univention,$ldap_base" \
		--append displayName='"fr_FR" "Forum Univention (Aide)"' \
		--append description='"fr_FR" "Forum Univention (Aide)"'
	univention-directory-manager portals/category modify --dn "cn=domain-service,cn=category,cn=portals,cn=univention,$ldap_base" \
		--append displayName='"fr_FR" "Applications"'
	univention-directory-manager portals/category modify --dn "cn=domain-admin,cn=category,cn=portals,cn=univention,$ldap_base" \
		--append displayName='"fr_FR" "Administration"'
fi

if [ "$1" = "configure" ] && dpkg --compare-versions "$2" lt-nl "4.0.5-75"; then
	univention-directory-manager portals/entry create --ignore_exists \
		--position "cn=entry,cn=portals,cn=univention,$ldap_base" \
		--set name=self-service-password-change \
		--append displayName='"en_US" "Change your password"' \
		--append displayName='"de_DE" "Ihr Passwort ändern"' \
		--append description='"en_US" "Change your password"' \
		--append description='"de_DE" "Ihr Passwort ändern"' \
		--append link='"en_US" "#/selfservice/passwordchange"' \
		--append allowedGroups="cn=Domain Users,cn=groups,$ldap_base" \
		--set icon="$(base64 /usr/share/univention-portal/key.svg)" \
		--set linkTarget=samewindow
	univention-directory-manager portals/portal modify --dn "cn=domain,cn=portal,cn=portals,cn=univention,$ldap_base" --ignore_not_exists \
		--append userLinks="cn=self-service-password-change,cn=entry,cn=portals,cn=univention,$ldap_base"
fi

exit 0
