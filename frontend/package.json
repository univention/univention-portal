  "scripts": {
    "build": "vue-cli-service build",
    "build-storybook": "storybook build -o dist/storybook",
    "deploy:firebase": "yarn build && firebase deploy",
    "generate-apis": "openapi-generator-cli generate",
    "lint": "vue-cli-service lint --no-fix",
    "lint:all": "yarn lint && stylelint \"{**/*.{scss,vue,styl}\"",
    "lint:fix": "vue-cli-service lint",
    "lint:fix:all": "yarn lint:fix && stylelint --fix \"{**/*.{scss,vue,styl}\"",
    "serve": "vue-cli-service serve",
    "serve:wait": "yarn serve & wait-on http://localhost:8080",
    "storybook": "storybook dev -p 6006 --debug-webpack",
    "test:coverage": "vue-cli-service test:unit --coverage",
    "test:e2e": "concurrently --kill-others --success first \"yarn serve\" \"wait-on http://localhost:8080 && cypress open\"",
    "test:e2e:headless": "concurrently --kill-others --success first \"yarn serve\" \"wait-on http://localhost:8080 && cypress run\"",
    "test:e2e:run": "wait-on http://localhost:8080 && cypress run",
    "test:unit": "vue-cli-service test:unit",
    "test:unit:updatesnapshots": "yarn test:unit --updateSnapshot",
    "test:unit:watch": "yarn test:unit --watch"
  },
  "version": "0.1.0"
